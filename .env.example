# --- Dev-mode backend (works with zero setup) --------------------------------
# Used to sign session cookies for the built-in file-based auth. Change this
# to any long random string before deploying anywhere real.
SESSION_SECRET=change-this-to-a-long-random-string

# Password for /admin (dashboard at /admin, /admin/products, /admin/orders).
ADMIN_PASSWORD=novae-admin

# --- Production backend (optional — see README "Going to production") -------
# Fill these in once you create a Supabase project and swap src/lib/db.ts
# for real Supabase calls.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay test mode keys (https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
